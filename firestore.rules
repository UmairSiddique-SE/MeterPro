rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only metadata used to notify users about new app releases.
    match /app_config/{platform} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Each signed-in user can only read/write their own meters.
    match /users/{userId}/meters/{meterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
