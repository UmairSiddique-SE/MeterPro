rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only metadata used to notify users about new app releases.
    match /app_config/{platform} {
      allow read: if true;
      allow write: if false;
    }

    // Authenticated users can read and manage their own profile and data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // OTP records
    match /emailOtps/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
