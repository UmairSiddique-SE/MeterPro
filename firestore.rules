rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_config/{platform} {
      allow read: if true;
      allow write: if false;
    }

    function owner() {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if owner();
      match /{allChildren=**} {
        allow read, write: if owner();
      }
    }
  }
}
